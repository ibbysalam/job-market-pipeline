{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.5", "generated_at": "2026-11-02T09:06:19.672128Z", "invocation_id": "c0a436a1-56a0-4547-9bd8-f0568ca8f295", "invocation_started_at": "2026-11-02T09:06:14.852959Z", "env": {}}, "results": [{"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:17.616018Z", "completed_at": "2026-11-02T09:06:17.672870Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:17.673957Z", "completed_at": "2026-11-02T09:06:17.743862Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.13342595100402832, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.accepted_values_stg_job_enrichment_open_to_nigeria__yes__no__unclear.64709cddaf", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        open_to_nigeria as value_field,\n        count(*) as n_records\n\n    from \"warehouse\".\"main\".\"stg_job_enrichment\"\n    group by open_to_nigeria\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'yes','no','unclear'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:17.761357Z", "completed_at": "2026-11-02T09:06:17.853061Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:17.854223Z", "completed_at": "2026-11-02T09:06:17.871689Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.11853408813476562, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.accepted_values_stg_job_enrichment_seniority__intern__junior__mid__senior__lead__unknown.b67dd50f7b", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        seniority as value_field,\n        count(*) as n_records\n\n    from \"warehouse\".\"main\".\"stg_job_enrichment\"\n    group by seniority\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'intern','junior','mid','senior','lead','unknown'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:17.880771Z", "completed_at": "2026-11-02T09:06:17.891794Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:17.893045Z", "completed_at": "2026-11-02T09:06:17.921866Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04883098602294922, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.assert_enrichment_has_no_garbled_text", "compiled": true, "compiled_code": "\n\n-- Garbled characters (like \"\u00c3\" in \"\u00c3\u2013sterreich\") mean broken encoding\n-- somewhere upstream. This is a WARNING and not an error on purpose: the\n-- pipeline still works, but a person should look. Choosing warn or error\n-- is a decision about how bad each problem really is.\n\nselect\n    job_id,\n    'AI answer contains garbled characters' as failure_reason\nfrom \"warehouse\".\"main\".\"stg_job_enrichment\"\nwhere regexp_matches(\n    coalesce(summary, '') || ' ' || coalesce(nigeria_evidence, ''),\n    '[\\x{C3}\\x{C2}]'\n)", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:17.947851Z", "completed_at": "2026-11-02T09:06:17.963697Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:17.965069Z", "completed_at": "2026-11-02T09:06:18.001515Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05882740020751953, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.assert_most_open_jobs_are_enriched", "compiled": true, "compiled_code": "\n\n-- If the AI step stops running (expired key, quota, a bug), the pipeline\n-- keeps going and the numbers quietly get worse. This turns that into a\n-- warning when more than 20 percent of the jobs open right now have not\n-- been read by the AI yet.\n\nselect\n    missing,\n    total,\n    'more than 20 percent of open jobs have no AI enrichment' as failure_reason\nfrom (\n    select\n        count(*) filter (where e.job_id is null) as missing,\n        count(*) as total\n    from \"warehouse\".\"main\".\"stg_remoteok_jobs\" as j\n    left join \"warehouse\".\"main\".\"stg_job_enrichment\" as e\n        on e.job_id = j.job_id\n)\nwhere total > 0\n  and missing * 1.0 / total > 0.2", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.012352Z", "completed_at": "2026-11-02T09:06:18.018629Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:18.022532Z", "completed_at": "2026-11-02T09:06:18.054233Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05172896385192871, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.assert_nigeria_answers_have_evidence", "compiled": true, "compiled_code": "-- Every \"yes\" or \"no\" about Nigeria must come with a quoted piece of\n-- evidence. enrich_jobs.py already enforces this before saving. This test\n-- is the second lock: if anyone changes the script, loads rows another\n-- way, or edits the table by hand, the warehouse still refuses it.\n\nselect\n    job_id,\n    open_to_nigeria,\n    'answered ' || open_to_nigeria || ' without evidence' as failure_reason\nfrom \"warehouse\".\"main\".\"stg_job_enrichment\"\nwhere open_to_nigeria in ('yes', 'no')\n  and (\n      nigeria_evidence is null\n      or trim(nigeria_evidence) = ''\n      or lower(trim(nigeria_evidence)) in ('none', 'n/a')\n  )", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.074821Z", "completed_at": "2026-11-02T09:06:18.078772Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:18.079871Z", "completed_at": "2026-11-02T09:06:18.105937Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.035569190979003906, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.assert_remoteok_jobs_not_empty", "compiled": true, "compiled_code": "-- A custom data quality test, beyond dbt's built-in not_null/unique.\n--\n-- dbt singular tests work backwards from what you'd expect: the query\n-- should return the rows that are WRONG. If it returns zero rows, the\n-- test passes. If it returns any rows, dbt fails the test and shows\n-- you those rows.\n--\n-- This one catches a silent failure mode specific to our extractor\n-- design: load_remoteok.py does CREATE OR REPLACE TABLE every run, so\n-- if remoteok.py ever came back with zero matching listings (an API\n-- outage, a broken filter, Remotive-style silent breakage) the raw\n-- table would quietly go to zero rows with no error anywhere. This\n-- test turns that silent failure into a loud one.\n\nselect 'raw_remoteok_jobs has zero rows' as failure_reason\nfrom \"warehouse\".\"main\".\"raw_remoteok_jobs\"\nhaving count(*) = 0", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.122402Z", "completed_at": "2026-11-02T09:06:18.130951Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:18.132335Z", "completed_at": "2026-11-02T09:06:18.159864Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04878735542297363, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.assert_skills_look_like_skills", "compiled": true, "compiled_code": "-- A skill should be a short, lowercase name like \"python\" or \"power bi\".\n-- Models sometimes return whole sentences, empty strings or stray capitals.\n-- This catches the answers that have the right shape but the wrong content.\n\nselect\n    job_id,\n    skill,\n    'skill is empty, not lowercase, or too long to be a name' as failure_reason\nfrom (\n    select job_id, unnest(skills) as skill\n    from \"warehouse\".\"main\".\"stg_job_enrichment\"\n)\nwhere trim(skill) = ''\n   or skill != lower(skill)\n   or length(skill) > 40", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.175586Z", "completed_at": "2026-11-02T09:06:18.233463Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:18.234723Z", "completed_at": "2026-11-02T09:06:18.252533Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.08246517181396484, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.not_null_job_postings_enriched_job_id.50f317e4c4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect job_id\nfrom \"warehouse\".\"main\".\"job_postings_enriched\"\nwhere job_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.274019Z", "completed_at": "2026-11-02T09:06:18.301815Z"}, {"name": "execute", "started_at": "2026-11-02T09:06:18.304115Z", "completed_at": "2026-11-02T09:06:18.327042Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05823993682861328, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.level3_job_market.not_null_skill_demand_skill.4db5ab6a23", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect skill\nfrom \"warehouse\".\"main\".\"skill_demand\"\nwhere skill is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-02T09:06:18.342525Z", "completed_at": "2026-11-02T09:06:18.362964Z"}, {"name