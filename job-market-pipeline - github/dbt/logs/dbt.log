    position as job_title,
    company,
    tags,
    location,
    nullif(salary_min, 0) as salary_min,
    nullif(salary_max, 0) as salary_max,
    url,
    try_cast(date as timestamp) as posted_at,
    loaded_at
from "warehouse"."main"."raw_remoteok_jobs"
  );

